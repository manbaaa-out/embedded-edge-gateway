[Unit]
Description=Embedded Edge Gateway
Documentation=https://github.com/<你的仓库地址>
After=network-online.target
Wants=network-online.target
# 若依赖本机 mosquitto broker,取消下面两行注释,确保 broker 先起:
After=mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gateway /etc/gateway.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# ---- 日志 ----
# 进程只往 stderr 写(AsyncLogger 单例的去向),轮转与持久化交给 journald。
# 这两行是 systemd 的默认值,写出来是为了说明日志归属:改成 File= 或 null 会
# 直接改变日志落点。`journalctl -u gateway -f` 即可跟随。
# 注意默认 journald 是 Storage=auto:/var/log/journal 不存在时只留内存,重启即失。
# 要保住重启前的日志,需 mkdir -p /var/log/journal 或设 Storage=persistent。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway

# ---- 安全加固(可选,但生产推荐)----
# 网关只需读配置、写自己的数据库,不需要乱碰系统其他地方:
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# 允许写入数据库目录(配合 db_path=/var/lib/gateway/...):
ReadWritePaths=/var/lib/gateway

[Install]
WantedBy=multi-user.target