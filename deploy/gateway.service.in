[Unit]
Description=Embedded Edge Gateway
Documentation=https://github.com/manbaaa-out/embedded-edge-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/gateway @GATEWAY_CONFIG_FILE@
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# 不以 root 运行。systemd 为本服务动态分配低权限用户；dialout 只用于访问 UART，
# StateDirectory 则创建并授权 /var/lib/gateway，进程无需持有系统目录写权限。
DynamicUser=yes
SupplementaryGroups=dialout
StateDirectory=gateway
StateDirectoryMode=0750

# ---- 日志 ----
# 进程只往 stderr 写(AsyncLogger 单例的去向),轮转与持久化交给 journald。
# 这两行是 systemd 的默认值,写出来是为了说明日志归属:改成 File= 或 null 会
# 直接改变日志落点。`journalctl -u gateway -f` 即可跟随。
# 注意默认 journald 是 Storage=auto:/var/log/journal 不存在时只留内存,重启即失。
# 要保住重启前的日志,需 mkdir -p /var/log/journal 或设 Storage=persistent。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway

# ---- 安全加固 ----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
