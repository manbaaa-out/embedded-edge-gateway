#pragma once
/**
 * @file
 * 监控页资源的生成头模板。CMake 在配置阶段用 assets/ 原文替换 @...@ 占位符，
 * HttpServer 随后把生成的字符串编入可执行文件，因此运行时不依赖静态文件目录。
 */
namespace gateway {
static const char* const kIndexHtml =  ///< 自有监控页 HTML 原文。
    R"GWHTML(@WEB_INDEX_HTML@)GWHTML";
static const char* const kUplotJs =  ///< 第三方 uPlot JavaScript 压缩资源。
    R"UPLOTJS(@WEB_UPLOT_JS@)UPLOTJS";
static const char* const kUplotCss =  ///< 第三方 uPlot CSS 压缩资源。
    R"UPLOTCSS(@WEB_UPLOT_CSS@)UPLOTCSS";
}
